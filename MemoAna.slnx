<Solution>
  <Folder Name="/MemoAna/" />
  <Folder Name="/MemoAna/.github/" />
  <Folder Name="/MemoAna/.github/workflows/">
    <File Path=".github/workflows/ci-ct-cd.yml" />
    <File Path=".github/workflows/deploy-pages.yml" />
  </Folder>
  <Folder Name="/MemoAna/docs/">
    <File Path="docs/project-architecture.md" />
  </Folder>
  <Folder Name="/MemoAna/scripts/">
    <File Path="adb.ps1" />
    <File Path="scripts/gen-cert.ps1" />
    <File Path="scripts/migrate.ps1" />
    <File Path="scripts/postgres.ps1" />
  </Folder>
  <Folder Name="/MemoAna/src/">
    <Project Path="src/MemoAna.Game/MemoAna.Game.csproj" />
    <Project Path="src/MemoAna/MemoAna.csproj">
      <Deploy Solution="Debug|*" />
    </Project>
    <Project Path="src/MemoAna.Server/MemoAna.Server.csproj" />
  </Folder>
  <Folder Name="/MemoAna/tests/">
    <Project Path="tests/MemoAna.Server.Tests/MemoAna.Server.Tests.csproj" />
    <Project Path="tests/MemoAna.UITests/MemoAna.UITests.csproj" />
    <Project Path="tests/MemoAna.UnitTests/MemoAna.UnitTests.csproj" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/MemoAna.Shared/MemoAna.Shared.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <Project Path="tools/Editor/Editor.csproj" />
  </Folder>
</Solution>
