# MemoAna local environment variables
#
# Copy this file to .env and replace every placeholder with the
# credentials/configuration for the Google Cloud / Play Games project.
#
# .env is ignored by Git. NEVER commit real credentials or secrets.

# Google Play Games Services
GOOGLE_PLAY_GAMES_APPLICATION_ID=your-play-games-application-id
GOOGLE_PLAY_GAMES_ANDROID_CLIENT_ID=your-google-oauth-android-client-id
GOOGLE_PLAY_GAMES_WEB_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_PLAY_GAMES_WEB_CLIENT_SECRET=your-google-oauth-web-client-secret

# Google OAuth / OpenID Connect
GOOGLE_PLAY_GAMES_AUTHORITY=https://accounts.google.com
GOOGLE_PLAY_GAMES_AUDIENCE=your-google-oauth-web-client-id
GOOGLE_PLAY_GAMES_VALID_AUDIENCE=your-google-oauth-web-client-id

# OAuth redirect URI used when exchanging the Play Games server auth code.
# Keep this value aligned with the OAuth client configuration and the
# redirectUri sent by the client to POST /api/v1/auth/login/google-play-games.
GOOGLE_PLAY_GAMES_REDIRECT_URI=https://localhost:5001/api/v1/auth/login/google-play-games/callback
