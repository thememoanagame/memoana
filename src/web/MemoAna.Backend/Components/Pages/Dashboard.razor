@page "/dashboard"
@attribute [Authorize]
@using MemoAna.Backend.Application.Common.Authorization
@inject IAuthenticatedUserClassifier UserClassifier
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4">Admin Area</MudText>
        <MudPaper Elevation="1" Class="pa-6">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">MemoAna</MudText>
                <MudText Typo="Typo.body1">
                    ADMIN/SUPPORT DASHBOARD
                </MudText>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || AuthenticationStateTask is null)
        {
            return;
        }

        AuthenticatedUserType userType = await UserClassifier.ClassifyAsync(
            (await AuthenticationStateTask).User);

        if (userType is AuthenticatedUserType.Player)
        {
            Navigation.NavigateTo("/main", replace: true);
        }
        else if (userType is AuthenticatedUserType.Unauthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }
}
