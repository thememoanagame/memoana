@page "/"

<div class="page">
    <MudImage Src="images/empty.png"
              Class="background-image"
              Alt="" />
    <div class="page-container">
        <MudText Class="container-title">
            @Localizer["GameName"].ToUpper()
        </MudText>
        <MudButton Href="/game" Class="menu-button">
            <div class="button-content">
                <div class="button-highlight"></div>
                <MudText Class="button-text">@Localizer["Play"]</MudText>
            </div>
        </MudButton>
        <MudButton Href="/options" Class="menu-button">
            <div class="button-content">
                <div class="button-highlight"></div>
                <MudText Class="button-text">@Localizer["Options"]</MudText>
            </div>
        </MudButton>
        <MudButton Href="/content" Class="menu-button">
            <div class="button-content">
                <div class="button-highlight"></div>
                <MudText Class="button-text">@Localizer["Content"]</MudText>
            </div>
        </MudButton>
        <MudButton Href="/about" Class="menu-button">
            <div class="button-content">
                <div class="button-highlight"></div>
                <MudText Class="button-text">@Localizer["About"]</MudText>
            </div>
        </MudButton>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await audio.PlayMainTitleAsync();
        await base.OnInitializedAsync();
    }
}
<style>
    
    .page {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    .background-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        z-index: 0;
    }

    .page-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        z-index: 1;
    }

    .container-title {
        font-family: Bangpop, sans-serif;
        font-size: 54px;
        font-weight: bold;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        color: burlywood;
        text-shadow: 4px 4px 2px rgba(0, 0, 0, 0.8);
    }

    .menu-button {
        position: relative;
        width: 200px;
        height: 50px;
        min-height: 50px;
        padding: 0;
        border-radius: 25px !important;
        background-color: burlywood;
        color: saddlebrown;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 4px 4px 2px rgba(189, 63, 21, 1.0);
        transition: transform 80ms ease, box-shadow 100ms ease;
    }

    .menu-button:hover {
        transform: translateY(-2px);
        box-shadow: 4px 5px 3px rgba(217, 217, 217, 1.0);
    }

    .menu-button:active {
        transform: translate(4px, 4px);
        box-shadow: 2px 2px 2px rgba(127, 127, 127, 1.0);
    }

    .button-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .button-highlight {
        position: absolute;
        top: 2px;
        left: 2px;
        right: 2px;
        height: 25px;
        background-color: lightgoldenrodyellow;
        border-radius: 18px;
        z-index: 0;
    }

    .button-text {
        position: relative;
        z-index: 1;
        font-family: Bangpop;
        font-size: 22px;
        font-weight: normal;
        color: saddlebrown;
        text-shadow: 4px 4px 2px rgba(250, 250, 210, 0.8);
    }

    @@font-face 
    {
        font-family: Bangpop;
        src: url('/fonts/Bangpop.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }
    @@media (max-height: 700px) {
        .page-container {
            gap: 12px;
        }
    }
</style>