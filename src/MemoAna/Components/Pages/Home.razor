@page "/"
<style>

    .page {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    .background-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        z-index: 0;
    }

    .page-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        z-index: 1;
    }

    .container-title {
        font-family: Bangpop, sans-serif;
        font-size: 54px;
        font-weight: bold;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        color: burlywood;
        text-shadow: 4px 4px 2px rgba(0, 0, 0, 0.8);
    }

    .top-right {
        top: calc(100vh * 0.07);
        right: calc(-100vw * 0.6);
    }

    .top-center {
        top: calc(100vh * 0.07);
        left: calc(100vw * 0.45);
        right: calc(100vw * 0.45);
    }

    .top-left { 
        top: calc(100vh * 0.07);
        left: calc(-100vh * 0.07);
    }

    .bottom-center {
        top: calc(100vh * 0.9);
        left: calc(100vh * 0.25);
    }

    .menu-button {
        position: relative;
        width: 200px;
        height: 50px;
        min-height: 50px;
        padding: 0;
        border-radius: 25px !important;
        background-color: burlywood;
        color: saddlebrown;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 4px 4px 2px rgba(189, 63, 21, 1.0);
        transition: transform 80ms ease, box-shadow 100ms ease;
    }

        .menu-button:hover {
            transform: translateY(-2px);
            box-shadow: 4px 5px 3px rgba(217, 217, 217, 1.0);
        }

        .menu-button:active {
            transform: translate(4px, 4px);
            box-shadow: 2px 2px 2px rgba(127, 127, 127, 1.0);
        }

    .button-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .button-highlight {
        position: absolute;
        top: 2px;
        left: 2px;
        right: 2px;
        height: 25px;
        background-color: lightgoldenrodyellow;
        border-radius: 18px;
        z-index: 0;
    }

    .button-text {
        position: relative;
        z-index: 1;
        font-family: Bangpop;
        font-size: 22px;
        font-weight: normal;
        color: saddlebrown;
        text-shadow: 4px 4px 2px rgba(250, 250, 210, 0.8);
    }

    @@font-face {
        font-family: Bangpop;
        src: url('/fonts/Bangpop.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    @@media (max-height: 700px) {
        .page-container {
            gap: 12px;
        }
        
        .menu-button {
            width: calc(100vh/5);
            margin: 10px;
        }        

        .top-right {
            top: calc(100vh * 0.785);
            right: calc(-50vw * 0.5);
        }
        
        .top-left {
            left: calc(100vh * 0.07);
        }

        .bottom-center {
            top: calc(100vh * 0.9);
            left: calc(100vh*0.25);
        }
    }
</style>
<div class="page">
    <MudImage Src="images/empty.png"
              Class="background-image"
              Alt="" />

    <MudButton Href="/game"
               Class="@(platform.IsWindows || platform.IsMacOS ? "menu-button top-center" : "menu-button top-left")"
               data-testid="start-game">
        <div class="button-content">
            <div class="button-highlight"></div>
            <MudText Class="button-text">@Localizer["Play"]</MudText>
        </div>
    </MudButton> 
    <MudButton Href="/content" Class="menu-button top-left">
        <div class="button-content">
            <div class="button-highlight"></div>
            <MudText Class="button-text">@Localizer["Content"]</MudText>
        </div>
    </MudButton>
    <MudButton Href="/about" Class="menu-button top-right">
        <div class="button-content">
            <div class="button-highlight"></div>
            <MudText Class="button-text">@Localizer["About"]</MudText>
        </div>
    </MudButton>
    @if (platform.IsWindows || platform.IsMacOS)
    {
        <MudButton OnClick="ExitApp" Class="menu-button bottom-center">
            <div class="button-content">
                <div class="button-highlight"></div>
                <MudText Class="button-text">@Localizer["Exit"]</MudText>
            </div>
        </MudButton>
    }

    <div class="page-container">
        <MudText Class="container-title">
            @Localizer["GameName"].ToUpper()
        </MudText>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await audio.PlayMainTitleAsync();
        await base.OnInitializedAsync();
    }

    private void ExitApp(MouseEventArgs args)
    {
        App.Current?.Quit();
    }
}
