@page "/content"
@using Microsoft.AspNetCore.Components

@inject ILogger<Game> logger
@inject IThemeService themeService
@inject IPVPService pvp
<div class="page">
    <img src="images/empty.png" class="game-background" alt="" />

    @if (IsBusy)
    {
        <div class="loading-container">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Warning" />
            <MudText Class="loading-text">@Localizer["LoadingBoard"]</MudText>
        </div>
    }
    else
    {
        <MudStack Class="theme-section d-flex align-stretch align-content-space-around flex-wrap flex-grow-1 gap-4">
            @if (Themes.Count == 0)
            {
                <div class="theme-loading">
                    <MudProgressCircular Indeterminate="true" Color="Color.Surface" Size="Size.Large" />
                </div>
            }
            else
            {
                <MudExpansionPanels @ref="panels" MultiExpansion="false" Gutters Style="display: flex;flex-direction: column;align-items: center;justify-content: center; top: calc(100vh/20);">
                    <div id="unique_id_scroll_section" class="theme-item-container scrollable-panels-container">
                        @foreach (var theme in Themes)
                        {
                            <MudExpansionPanel Text="@theme.ThemeName" Class="theme-select-button " @onclick="@(async () => await SelectThemeAsync(theme))" Style="min-width: 30svw;">
                                <MudCarousel TData="string" ItemsSource="@Cards" Class="card-section" @bind-SelectedIndex="selectedCardIndex" AutoCycle="false" EnableSwipeGesture="true" ShowArrows="true">
                                    <ItemTemplate Context="themeCard">
                                        <div style="position: relative;">
                                            <MudIconButton Edge="Edge.End" Icon="@Icons.Material.Filled.Close" OnClick="@(async () => await ClearAsync())" />
                                            <div class="card-item">
                                                <div class="card-select-button">
                                                    <MudImage Src="@(themeCard)" Class="theme-image" />
                                                </div>
                                            </div>
                                        </div>
                                    </ItemTemplate>
                                </MudCarousel>
                            </MudExpansionPanel>  
                        } 
                    </div>
                </MudExpansionPanels>
            }
        </MudStack>
    }
</div>

@code {
    private MudExpansionPanels? panels;
    private int selectedCardIndex { get; set; } = 0;
    private int selectedIndex { get; set; } = 0; 
    private bool IsBusy { get; set; }
    private CardThemeManifestDto? SelectedTheme { get; set; }
    private ObservableCollection<CardThemeManifestDto> Themes { get; } = [];
    private ObservableCollection<string> Cards { get; set; } = [];
   
    protected override async Task OnInitializedAsync()
    {
        await audio.PlayMainTitleAsync();
        await LoadThemesAsync();
    }

    private async Task ClearAsync() {
        Cards.Clear();
        SelectedTheme = null;
        await panels?.CollapseAllAsync();
    }

    private async Task SelectThemeAsync(CardThemeManifestDto theme)
    {
        SelectedTheme = theme; 
        Cards = new ObservableCollection<string>();
        if (theme.CardTheme is null) return;
        foreach (var img in theme.CardTheme.ImagesSrc)
            Cards.Add(img);
        await InvokeAsync(StateHasChanged);
    }
  
    private async Task LoadThemesAsync()
    {
        try
        {
            IsBusy = true;
            logger.LogInformation("Loading Themes...");

            IEnumerable<CardThemeManifestDto> themes = await themeService.GetThemesAsync(true);

            Themes.Clear();
            await InvokeAsync(StateHasChanged);
            foreach (CardThemeManifestDto theme in themes)
                Themes.Add(theme);

            logger.LogInformation("Themes loaded. Count: {Count}", Themes.Count);
        }
        catch (Exception e)
        {
            logger.LogError(e, "Error when getting themes: {Message}", e.Message);
        }
        finally
        {
            IsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoToMain() => navigation.NavigateTo("/");

}

<style>
    .game-selection-page,
    .page {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    .selection-background,
    .game-background {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        z-index: 0;
        pointer-events: none;
        user-select: none;
    }
 

    .selection-options {
        display: inline-flex;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        width: 100%;
        margin-top: 20px;
    }

    .theme-carousel {
        width: 70dvw;
        height: 70dvh;
    }
  
    .card-section {
        position: relative;
        left: 0;
        right: 0;
        height: calc(100vh - 350px);
        min-height: 270px;
        display: flex !important;
        flex-direction: column;
        align-items: center;
        z-index: 2;
    }

    .theme-title,
    .theme-name {
        font-family: Bangpop;
        font-weight: bolder;
        color: saddlebrown;
        text-align: center;
        text-shadow: 2px 2px 1px rgba(250, 250, 210, 0.9);
    }

    .theme-title {
        font-size: 22px;
    }
     

    .card-item {
        width: 350px;
        height: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 40px;
        margin: auto;
        user-select: none;
    }

    .theme-card-header {
        display: flex;
        align-items: center;
        justify-content: center;
    }
     
    .theme-section {
        height: calc(100vh - 600px);
    }

    .theme-item-container {
        overflow-y: scroll; 
        padding: 8px;
        width:60svw;
    }

    .theme-item {
        width: fit-content;
    }

    .theme-select-button {
        box-sizing: border-box;
        background-color: burlywood;
        border: 5px solid saddlebrown;
        border-radius: 10px;
        box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.5);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        outline: none;
        pointer-events: auto;
    }

    .theme-select-button:hover {
        transform: scale(1.03);
    }


    .card-select-button {
        width: 450px;
        height: auto;
        padding: 5px;
        box-sizing: border-box;
        background-color: burlywood;
        border: 5px solid saddlebrown;
        border-radius: 10px;
        box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.5);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
        display: block;
        appearance: none;
        -webkit-appearance: none;
        outline: none;
        pointer-events: auto;
    }

    .card-select-button:hover {
        transform: scale(1.05);
        box-shadow: 0 0 0 3px lightgoldenrodyellow, 3px 3px 3px rgba(0, 0, 0, 0.5);
    }

    
    .theme-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: fill;
        pointer-events: none;
    }

    .theme-name {
        font-size: 28px;
    }

    .theme-loading {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loading-container {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 15px;
        z-index: 10;
    }

    .loading-text {
        font-family: Bangpop;
        font-size: 20px;
        color: saddlebrown;
        text-shadow: 2px 2px 1px rgba(250, 250, 210, 0.9);
    }

    .game-action-button {
        min-width: 140px;
        background-color: burlywood;
        color: saddlebrown;
        font-family: Bangpop;
        box-shadow: 4px 4px 2px rgba(139, 69, 19, 0.8);
    }

    .scrollable-panels-container {
        max-height: calc(100vh/1.2); 
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 8px;
    }

    .scrollable-panels-container::-webkit-scrollbar {
        width: 6px;
    }
    .scrollable-panels-container::-webkit-scrollbar-thumb {
        background-color: rgba(128, 128, 128, 0.4);
        border-radius: 4px;
    }

    @@font-face {
        font-family: Bangpop;
        src: url('/fonts/Bangpop.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    @@media (max-height: 750px) {
        .difficulty-section {
            top: 120px;
        }

        .selection-options {
            gap: 12px;
        }

        .selection-button {
            height: 44px;
            min-height: 44px;
        }

        .theme-section {
            height: calc(100vh - 350px);
        }
    }

    @@media (max-width: 600px) {
        .difficulty-section {
            top: 120px;
        }

        .selection-options {
            width: 60svw;
            gap: 15px;
        }

        .theme-section {
            bottom: 10px;
        }


        .theme-select-button {
            width: 175px;
            height: 175px;
        }
    }
</style>
