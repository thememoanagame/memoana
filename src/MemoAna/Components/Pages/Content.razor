@page "/content"
@using Microsoft.AspNetCore.Components

@inject ILogger<Game> logger
@inject IThemeService themeService
@inject IPVPService pvp
<div class="page">
    <img src="images/empty.png" class="game-background" alt="" />

    @if (IsBusy)
    {
        <div class="loading-container">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Warning" />
            <MudText Class="loading-text">@Localizer["LoadingBoard"]</MudText>
        </div>
    }
    else
    {

        <MudStack>
            <MudText Class="theme-title">
                @Localizer["ThemeSelection"]
            </MudText>

            <div class="theme-section">
                @if (Themes.Count == 0)
                {
                    <div class="theme-loading">
                        <MudProgressCircular Indeterminate="true" Color="Color.Surface" Size="Size.Large" />
                    </div>
                }
                else
                {
                    <MudCarousel TData="CardThemeManifestDto" ItemsSource="@Themes" Class="theme-section theme-carousel"  Style="height: 70svh;"
                                @bind-SelectedIndex="selectedIndex" AutoCycle="false" EnableSwipeGesture="true">
                        <ItemTemplate Context="theme">
                            <div class="theme-item">
                                <div class="theme-card-header">
                                    <MudText Class="theme-name">@theme.ThemeName</MudText>
                                </div>
                                <MudButton Class=@("theme-select-button theme-preview-selected") data-testid="theme-select-button"
                                        OnClick="@(async () => await SelectThemeAsync(theme))">
                                    <MudImage Src="@GetThemeImage(theme)" Class="theme-image" Alt="@theme.ThemeName" />
                                </MudButton>
                            </div>
                        </ItemTemplate>
                    </MudCarousel>
                }
                
                @if (Cards.Count == 0)
                {
                    <div class="theme-loading">
                        <MudProgressCircular Indeterminate="true" Color="Color.Surface" Size="Size.Large" />
                    </div>
                }
                else
                {
                    <MudCarousel TData="string" ItemsSource="@Cards" Class=" card-section card-carousel" Style="height: 70svh;"
                                @bind-SelectedIndex="selectedCardIndex" AutoCycle="false" EnableSwipeGesture="true">
                                
                        <ItemTemplate Context="themeCard">
                            
                            <div class="card-item">
                                <MudIconButton Edge="Edge.End" Icon="@Icons.Material.Filled.Close" OnClick="@(async () => await ClearAsync())" Style="right: 0%;" />
                                <div class="card-select-button card-preview-selected">
                                    <MudImage Src="@(themeCard)" Class="theme-image" />
                                </div>
                            </div>
                        </ItemTemplate>
                    </MudCarousel>
                }
            </div>
        </MudStack>
    }
</div>

@code {
    private int selectedCardIndex { get; set; } = 0;
    private int selectedIndex { get; set; } = 0; 
    private bool IsBusy { get; set; }
    private CardThemeManifestDto? SelectedTheme { get; set; }
    private ObservableCollection<CardThemeManifestDto> Themes { get; } = [];
    private ObservableCollection<string> Cards { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadThemesAsync();
    }

    private async Task ClearAsync() => Cards.Clear();
    private async Task SelectThemeAsync(CardThemeManifestDto theme)
    {
        SelectedTheme = theme; 
        Cards = new ObservableCollection<string>();
        if (theme.CardTheme is null) return;
        foreach (var img in theme.CardTheme.Base64Images)
            Cards.Add(img);
        await InvokeAsync(StateHasChanged);
    }
 
    private static string GetThemeImage(CardThemeManifestDto theme)
    {
        if (string.IsNullOrWhiteSpace(theme.PreviewBase64Image))
            return string.Empty;

        if (theme.PreviewBase64Image.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            return theme.PreviewBase64Image;

        return $"data:image/png;base64,{theme.PreviewBase64Image}";
    }

    private async Task LoadThemesAsync()
    {
        try
        {
            IsBusy = true;
            logger.LogInformation("Loading Themes...");

            IEnumerable<CardThemeManifestDto> themes = await themeService.GetThemesAsync(true);

            Themes.Clear();
            await InvokeAsync(StateHasChanged);
            foreach (CardThemeManifestDto theme in themes)
                Themes.Add(theme);

            logger.LogInformation("Themes loaded. Count: {Count}", Themes.Count);
        }
        catch (Exception e)
        {
            logger.LogError(e, "Error when getting themes: {Message}", e.Message);
        }
        finally
        {
            IsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoToMain() => navigation.NavigateTo("/");

}

<style>
