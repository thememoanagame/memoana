@page "/license"
@layout MainLayout

<div class="page">
    <MudImage Src="images/empty.png"
              Class="background-image"
              Alt="" />
    <MudButton StartIcon="@Icons.Material.Rounded.ArrowBack" IconColor="Color.Primary" Href="/about" 
        Class="menu-button top-left" data-testid="content-button">
        <div class="button-content">
            <div class="button-highlight"></div>
            <MudText Class="button-text">@Localizer["Back"]</MudText>
        </div>
    </MudButton>
    <div class="page-container">
         
    </div>
     
</div>
@code {

    protected override async Task OnInitializedAsync()
    {
        await audio.PlayMainTitleAsync();
        await base.OnInitializedAsync();
    }

    string Version { get; } = "1.0.0-dev";
    private void ShowDeveloperInfoModal()
    {

    }
}
<style>
    .page {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }
    .background-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        z-index: 0;
    }
    .page-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        z-index: 1;
    }
    .container-title {
        font-family: Bangpop, sans-serif;
        font-size: 54px;
        font-weight: bold;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        color: burlywood;
        text-shadow: 4px 4px 2px rgba(0, 0, 0, 0.8);
    }
     .top-left { 
        top: calc(100vh * 0.07);
        left: calc(100vw * 0.45);
    }

    .bottom-center {
        top: calc(100vh * 0.9);
        left: calc(100vw * 0.45);
    }

    .menu-button {
        position: relative;
        width: calc(100vw/2.5);
        height: 50px;
        min-height: 50px;
        padding: 0;
        border-radius: 25px !important;
        @* background-color: burlywood; *@
        background-color: lightgoldenrodyellow;
        border: 10px solid burlywood;
        color: saddlebrown;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 4px 4px 2px rgba(189, 63, 21, 1.0);
        transition: transform 80ms ease, box-shadow 100ms ease;
    }

        .menu-button:hover {
            transform: translateY(-2px);
            box-shadow: 4px 5px 3px rgba(217, 217, 217, 1.0);
        }

        .menu-button:active {
            transform: translate(4px, 4px);
            box-shadow: 2px 2px 2px rgba(172, 172, 172, 1.0);
        }

    .button-content {
        position: relative; 
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .button-highlight {
        position: absolute;
        top: 2px;
        left: 2px;
        right: 2px;
        height: 25px;
        background-color: lightgoldenrodyellow;
        border-radius: 18px;
        z-index: 0;
    }

    .button-text {
        position: relative;
        z-index: 1;
        font-family: Bangpop;
        font-size: 22px;
        font-weight: normal;
        color: saddlebrown;
        text-shadow: 4px 4px 2px rgba(250, 250, 210, 0.8);
    }
    .version-text {
        position: absolute;
        bottom: 16px;
        left: 50%;
        font: 'Bangpop';
        transform: translateX(-50%);
        z-index: 1;
        font-size: 24px;
        color: #000000;
    }  
    @@font-face 
    {
        font-family: Bangpop;
        src: url('/fonts/Bangpop.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }
    @@media (max-height: 700px) {
        .page-container {
            gap: 12px;
        }
    }
</style>