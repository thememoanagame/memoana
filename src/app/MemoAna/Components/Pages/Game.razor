@page "/game"
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable
@inject ILogger<Game> logger
@inject IThemeService themeService

@if (IsSelecting)
{
    <div class="game-selection-page">
        <img src="images/empty.png" class="selection-background" alt="" />

        <div class="difficulty-section">
            <MudText Class="selection-title">
                @Localizer["Difficulty"]
            </MudText>

            <MudToggleGroup T="string"
                            Class="selection-options"
                            Value="@Difficulty"
                            ValueChanged="OnDifficultyChanged"
                            CheckMark="true"
                            Vertical="false"
                            Outlined
                            Color="Color.Surface">
                <MudToggleItem T="string"
                               Class="selection-button"
                               SelectedIcon="@Icons.Material.TwoTone.Check"
                               Value="@("0")">
                    @Localizer["Starter"]
                </MudToggleItem>
                <MudToggleItem T="string"
                               Class="selection-button"
                               SelectedIcon="@Icons.Material.TwoTone.Check"
                               Value="@("1")">
                    @Localizer["Medium"]
                </MudToggleItem>
                <MudToggleItem T="string"
                               Class="selection-button"
                               SelectedIcon="@Icons.Material.TwoTone.Check"
                               Value="@("2")">
                    @Localizer["Hard"]
                </MudToggleItem>
            </MudToggleGroup>

            <MudText Class="selection-title mode-title">
                @Localizer["GameMode"]
            </MudText>

            <MudToggleGroup T="string"
                            Class="selection-options"
                            @bind-Value="Mode"
                            CheckMark="true"
                            Vertical="false"
                            Outlined
                            Color="Color.Surface">
                <MudToggleItem T="string"
                               Class="selection-button"
                               SelectedIcon="@Icons.Material.Filled.Computer"
                               UnselectedIcon="@Icons.Material.TwoTone.Computer"
                               Value="@("0")">
                    <MudText Align="Align.Center" Typo="Typo.caption">
                        @Localizer["IA"]
                    </MudText>
                </MudToggleItem>
                <MudToggleItem T="string"
                               Class="selection-button"
                               SelectedIcon="@Icons.Material.Filled.Timer"
                               UnselectedIcon="@Icons.Material.TwoTone.Timer"
                               Value="@("1")">
                    <MudText Align="Align.Center" Typo="Typo.caption">
                        @Localizer["TimeAttack"]
                    </MudText>
                </MudToggleItem>
                <MudToggleItem T="string"
                               Class="selection-button"
                               SelectedIcon="@Icons.Material.Filled.PersonAdd"
                               UnselectedIcon="@Icons.Material.TwoTone.PersonAdd"
                               Value="@("2")">
                    <MudText Align="Align.Center" Typo="Typo.caption">
                        @Localizer["PVP"]
                    </MudText>
                </MudToggleItem>
            </MudToggleGroup>
        </div>

        <div class="theme-section">
            <MudText Class="theme-title">
                @Localizer["ThemeSelection"]
            </MudText>

            @if (Themes.Count == 0)
            {
                <div class="theme-loading">
                    <MudProgressCircular Indeterminate="true" Color="Color.Surface" Size="Size.Large" />
                </div>
            }
            else
            {
                <MudCarousel TData="CardThemeManifestDto"
                             ItemsSource="@Themes"
                             Class="theme-carousel"
                             Style="height:70vh;"
                             @bind-SelectedIndex="selectedIndex"
                             AutoCycle="false"
                             EnableSwipeGesture="true"
                             ShowArrows="true"
                             ShowBullets="true"                  
                             BulletsColor="Color.Surface"
                             ArrowsColor="Color.Surface">
                    <ItemTemplate Context="theme">
                        <div class="theme-item">
                            <div class="theme-card-header">
                                <MudText Class="theme-name">@theme.ThemeName</MudText>
                            </div>
                            <MudButton Class=@("theme-select-button "+(IsSelected(theme) ? "theme-preview-selected" : string.Empty)) OnClick="@(async () => await SelectThemeAsync(theme))">
                                <MudImage Src="@GetThemeImage(theme)" Class="theme-image" Alt="@theme.ThemeName" />
                            </MudButton>
                        </div>
                    </ItemTemplate>
                </MudCarousel>
            }
        </div>
    </div>
}
else
{
    <div class="game-page">
        <img src="images/empty.png" class="game-background" alt="" />

        @if (IsBusy)
        {
            <div class="loading-container">
                <MudProgressCircular Indeterminate="true"
                                     Size="Size.Large"
                                     Color="Color.Warning" />
                <MudText Class="loading-text">Preparando Tabuleiro...</MudText>
            </div>
        }
        else if (IsGameActive)
        {
            <div class="game-header">
                <MudText Class="game-header-score">@CurrentScore</MudText>
                <MudText Class="game-header-moves">@MovesCount</MudText>
                <MudText Class="game-header-time">@GameTime</MudText>
            </div>

            <div class="game-board" style="--columns: @Columns">
                @foreach (KeyValuePair<int, MemoryCard> card in Cards)
                {
                    <div class="memory-card" @onclick="() => FlipCard(card.Key, card.Value)">
                        @if (!card.Value.IsFaceUp)
                        {
                            <img src="images/back.png" class="card-image card-back" alt="" />
                        }
                        else
                        {
                            <img src="@card.Value.CardImage" class="card-image card-face" alt="" />
                        }
                    </div>
                }
            </div>
        }
        else if (IsGameFinished)
        {
            <div class="statistics-container">
                <MudText Class="victory-text">@IsVictory</MudText>
                <div class="statistics-grid">
                    <MudText Class="statistic-value statistic-left">@Statistics.ThemeName</MudText>
                    <MudText Class="statistic-value statistic-right">@Statistics.Difficulty</MudText>
                    <MudText Class="statistic-value statistic-center">@Statistics.PlayedAt</MudText>
                    <MudText Class="statistic-label">ACERTOS</MudText>
                    <MudText Class="statistic-value statistic-right">@Statistics.SuccessfulMoves</MudText>
                    <MudText Class="statistic-label">ERROS</MudText>
                    <MudText Class="statistic-value statistic-right">@Statistics.Mistakes</MudText>
                    <MudText Class="statistic-label">SOMA</MudText>
                    <MudText Class="statistic-value statistic-right">@Statistics.TotalMoves</MudText>
                    <MudText Class="statistic-label">PONTOS</MudText>
                    <MudText Class="statistic-value statistic-right">@CurrentScore</MudText>
                    <MudText Class="statistic-label">TOTAL</MudText>
                    <MudText Class="statistic-value statistic-right">@Statistics.FinalScore</MudText>
                </div>
            </div>

            <div class="game-actions">
                <MudButton Class="game-action-button" OnClick="GoToMain">INICIO</MudButton>
                <MudButton Class="game-action-button game-action-repeat" OnClick="RestartGame">REPETIR</MudButton>
            </div>
        }
    </div>
}

@code {
    private bool IsSelecting { get; set; } = true;
    private bool IsBusy { get; set; }
    /// <summary> Flag to mark if the game is currently active (running).</summary>
    private bool IsGameActive { get; set; }
    /// <summary> Flag to mark if the game is currently finished.</summary>
    private bool IsGameFinished { get; set; }
    private string Theme { get; set; } = string.Empty;
    private string GameTime { get; set; } = "00:00";
    private string CurrentScore { get; set; } = "000";
    private string MovesCount { get; set; } = "0";
    private string IsVictory { get; set; } = string.Empty;

    private int Rows { get; set; } = 3;
    private int Columns { get; set; } = 4;
    private int selectedIndex;

    private string? Difficulty { get; set; }
    private string Mode { get; set; } = "1";

    private CardThemeManifestDto? SelectedTheme { get; set; }
    private ObservableCollection<CardThemeManifestDto> Themes { get; } = [];
    private ObservableCollection<KeyValuePair<int, MemoryCard>> Cards { get; } = [];

    private GameStatisticsDto Statistics { get; set; } = GameStatisticsDto.Default;
    private bool _eventsAttached;

    protected override async Task OnInitializedAsync()
    {
        await LoadThemesAsync();
    }

    private async Task OnDifficultyChanged(string? value)
    {
        Difficulty = value;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectThemeAsync(CardThemeManifestDto theme)
    {
        SelectedTheme = theme;
        await InvokeAsync(StateHasChanged);

        if (string.IsNullOrWhiteSpace(Difficulty))
            return;

        await StartSelectedGameAsync();
    }

    private bool IsSelected(CardThemeManifestDto theme)
    {
        return SelectedTheme?.CardThemeId == theme.CardThemeId;
    }

    private static string GetThemeImage(CardThemeManifestDto theme)
    {
        if (string.IsNullOrWhiteSpace(theme.PreviewBase64Image))
            return string.Empty;

        if (theme.PreviewBase64Image.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            return theme.PreviewBase64Image;

        return $"data:image/png;base64,{theme.PreviewBase64Image}";
    }

    private async Task LoadThemesAsync()
    {
        try
        {
            IsBusy = true;
            logger.LogInformation("Loading Themes...");

            IEnumerable<CardThemeManifestDto> themes = await themeService.GetThemesAsync();

            Themes.Clear();
            foreach (CardThemeManifestDto theme in themes)
                Themes.Add(theme);

            logger.LogInformation("Themes loaded. Count: {Count}", Themes.Count);
        }
        catch (Exception e)
        {
            logger.LogError(e, "Error when getting themes: {Message}", e.Message);
        }
        finally
        {
            IsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartSelectedGameAsync()
    {
        if (IsBusy || SelectedTheme is null || !int.TryParse(Difficulty, out int level) || Mode == "2")
            return;

        IsBusy = true;
        IsSelecting = false;
        IsGameActive = false;
        IsGameFinished = false;
        IsVictory = string.Empty;
        Statistics = GameStatisticsDto.Default;
        Cards.Clear();

        try
        {
            ConfigureGridGeometry(level);
            Theme = SelectedTheme.ThemeName;

            AttachGameEvents();

            await game.StartGameAsync(level, Theme, Mode);

            foreach (KeyValuePair<int, MemoryCard> card in game.CurrentCards)
                Cards.Add(card);

            GameTime = game.CurrentMode == GameMode.TimeAttack
                ? TimeSpan.FromSeconds(GetInitialTime(level)).ToString("mm\\:ss")
                : "--:--";
            CurrentScore = game.CurrentScore.ToString("D3");
            MovesCount = game.TotalMoves.ToString();
            IsGameActive = true;

            await audio.StopAsync();
            await audio.PlayMainGameAsync();

            logger.LogInformation(
                "Game initialized. Theme: {Theme}, Difficulty: {Difficulty}, Mode: {Mode}, Cards: {CardCount}",
                Theme,
                level,
                Mode,
                Cards.Count);
        }
        catch (Exception e)
        {
            logger.LogError(
                e,
                "Error initializing game. Theme: {Theme}, Difficulty: {Difficulty}",
                Theme,
                Difficulty);

            IsSelecting = true;
            IsGameActive = false;
            IsGameFinished = false;
        }
        finally
        {
            IsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static int GetInitialTime(int difficulty) => difficulty switch
    {
        0 => 75,
        1 => 100,
        2 => 150,
        _ => 75
    };

    private void AttachGameEvents()
    {
        if (_eventsAttached)
            return;

        game.GameFinished += OnGameFinished;
        game.TimerTick += OnTimerTick;
        game.CardFlipped += OnCardFlipped;
        _eventsAttached = true;
    }

    private async Task FlipCard(int position, MemoryCard card)
    {
        if (!IsGameActive || game.IsHumanInteractionBlocked || card.IsFaceUp || card.IsMatched)
            return;

        try
        {
            await game.FlipCardAsync(position, card);
            MovesCount = game.TotalMoves.ToString();
            CurrentScore = game.CurrentScore.ToString("D3");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnTimerTick(object? sender, GameTickEventArgs gameTick)
    {
        _ = InvokeAsync(() =>
        {
            GameTime = gameTick.NextTime;
            CurrentScore = game.CurrentScore.ToString("D3");
            StateHasChanged();
        });
    }

    private void OnGameFinished(object? sender, GameStatisticsEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            IsGameActive = false;
            IsGameFinished = true;
            Statistics = new GameStatisticsDto(
                e.ThemeName,
                e.Difficulty,
                e.PlayedAt,
                e.IsVictory,
                e.RemainingSeconds,
                e.TotalMoves,
                e.SuccessfulMoves,
                e.Mistakes,
                e.FinalScore);
            IsVictory = e.IsVictory ? "+1 CONQUISTA!" : "DERROTA!";
            CurrentScore = e.FinalScore.ToString("D3");
            await audio.StopAsync();
            StateHasChanged();
        });
    }

    private void OnCardFlipped(object? sender, GameCardFlippedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ConfigureGridGeometry(int difficulty)
    {
        (Rows, Columns) = difficulty switch
        {
            0 => (4, 3),
            1 => (5, 4),
            2 => (6, 5),
            _ => (4, 3)
        };
    }

    private void GoToMain() => navigation.NavigateTo("/");

    private void RestartGame()
    {
        game.ForceStopTimer();
        IsSelecting = true;
        IsGameActive = false;
        IsGameFinished = false;
        SelectedTheme = null;
        Cards.Clear();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CleanupGame()
    {
        if (_eventsAttached)
        {
            game.GameFinished -= OnGameFinished;
            game.TimerTick -= OnTimerTick;
            game.CardFlipped -= OnCardFlipped;
            _eventsAttached = false;
        }

        if (game is GameService service)
            service.ForceStopTimer();

        IsGameActive = false;
        await audio.StopAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await CleanupGame();
    }
}

<style>
    .game-selection-page,
    .game-page {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    .selection-background,
    .game-background {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        z-index: 0;
        pointer-events: none;
        user-select: none;
    }

    .difficulty-section {
        position: absolute;
        top: 150px;
        left: 50%;
        transform: translateX(-50%);
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        z-index: 2;
    }

    .selection-title,
    .mode-title {
        font-family: Bangpop;
        font-size: 32px;
        font-weight: bolder;
        color: saddlebrown;
        text-align: center;
        text-shadow: 2px 2px 2px rgba(188, 143, 143, 0.8);
    }

    .mode-title {
        margin-top: 10px;
    }

    .selection-options {
        display: inline-flex;
        flex-direction: row;
        align-items: center;
        gap: 25px;
        width: 150px;
        margin-top: 20px;
    }

    .selection-button {
        position: relative;
        background-color: burlywood;
        color: saddlebrown;
        box-shadow: 4px 4px 2px rgba(139, 69, 19, 0.8);
        overflow: hidden;
    }

    .theme-section {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 20px;
        height: calc(100vh - 400px);
        min-height: 270px;
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 2;
    }

    .theme-title,
    .theme-name {
        font-family: Bangpop;
        font-weight: bolder;
        color: saddlebrown;
        text-align: center;
        text-shadow: 2px 2px 1px rgba(250, 250, 210, 0.9);
    }

    .theme-title {
        font-size: 22px;
    }

    .theme-carousel {
        width: 70dvw;
        height: 70dvh;
        flex: 1 1 auto;
        min-height: 0;
        margin: 30px 0;
    }

    .theme-carousel > .d-flex {
        pointer-events: none;
    }

    .theme-carousel > .d-flex button,
    .theme-carousel > .d-flex .mud-icon-button,
    .theme-carousel > .d-flex .mud-button-root,
    .theme-carousel > .d-flex [tabindex] {
        pointer-events: auto;
    }

    .theme-item {
        width: 250px;
        height: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin: auto;
        user-select: none;
    }

    .theme-card-header {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .theme-select-button {
        width: 250px;
        height: 250px;
        padding: 5px;
        box-sizing: border-box;
        background-color: burlywood;
        border: 5px solid saddlebrown;
        border-radius: 10px;
        box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.5);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
        display: block;
        appearance: none;
        -webkit-appearance: none;
        outline: none;
        pointer-events: auto;
    }

    .theme-select-button:hover {
        transform: scale(1.03);
    }

    .theme-preview-selected {
        box-shadow: 0 0 0 3px lightgoldenrodyellow, 3px 3px 3px rgba(0, 0, 0, 0.5);
    }

    .theme-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: fill;
        pointer-events: none;
    }

    .theme-name {
        font-size: 28px;
    }

    .theme-loading {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loading-container {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 15px;
        z-index: 10;
    }

    .loading-text {
        font-family: Bangpop;
        font-size: 20px;
        color: saddlebrown;
        text-shadow: 2px 2px 1px rgba(250, 250, 210, 0.9);
    }

    .game-header {
        position: absolute;
        top: 40px;
        left: 20px;
        right: 20px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
        z-index: 2;
    }

    .game-header-score,
    .game-header-moves,
    .game-header-time {
        font-family: Bangpop;
        font-size: 48px;
        color: lightgoldenrodyellow;
        line-height: 1;
    }

    .game-header-score { text-align: left; }
    .game-header-moves { text-align: center; }
    .game-header-time { text-align: right; }

    .game-board {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: grid;
        grid-template-columns: repeat(var(--columns), 70px);
        gap: 10px;
        z-index: 2;
    }

    .memory-card {
        width: 70px;
        height: 90px;
        cursor: pointer;
        user-select: none;
        transition: transform 0.12s ease, filter 0.12s ease;
    }

    .memory-card:hover { filter: brightness(1.05); }
    .memory-card:active { transform: scale(0.95); }

    .card-image {
        width: 100%;
        height: 100%;
        display: block;
        box-sizing: border-box;
        pointer-events: none;
    }

    .card-face { object-fit: contain; }
    .card-back { object-fit: cover; }

    .statistics-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        min-width: 300px;
        text-align: center;
    }

    .victory-text {
        font-family: Bangpop;
        font-size: 36px;
        color: saddlebrown;
        text-shadow: 2px 2px 1px lightgoldenrodyellow;
    }

    .statistics-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 20px;
        margin-top: 25px;
    }

    .statistic-label,
    .statistic-value {
        font-family: Bangpop;
        color: saddlebrown;
        font-size: 20px;
    }

    .statistic-left { text-align: center; }
    .statistic-right { text-align: center; }
    .statistic-center { grid-column: 1 / -1; text-align: center; }

    .game-actions {
        position: absolute;
        bottom: 20%;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 25px;
        z-index: 3;
    }

    .game-action-button {
        min-width: 140px;
        background-color: burlywood;
        color: saddlebrown;
        font-family: Bangpop;
        box-shadow: 4px 4px 2px rgba(139, 69, 19, 0.8);
    }

    @@font-face {
        font-family: Bangpop;
        src: url('/fonts/Bangpop.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    @@media (max-height: 750px) {
        .difficulty-section { top: 120px; }
        .selection-options { gap: 12px; }
        .selection-button { height: 44px; min-height: 44px; }
        .theme-section { height: calc(100vh - 350px); }
    }

    @@media (max-width: 600px) {
        .difficulty-section { top: 120px; }
        .selection-options { width: 60svw; gap: 15px; }
        .theme-section { bottom: 10px; }
        .theme-item { width: 175px; }
        .theme-select-button { width: 175px; height: 175px; }
    }
</style>
